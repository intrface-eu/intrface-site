{
  "name": "@intrface/workspace",
  "private": true,
  "packageManager": "bun@1.2.21",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@intrface/web",
    "dev:aoc": "turbo run dev --filter=@intrface/aoc-web",
    "dev:convex": "turbo run dev --filter=@intrface/convex",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=@intrface/web",
    "build:aoc": "turbo run build --filter=@intrface/aoc-web",
    "lint": "turbo run lint",
    "lint:web": "turbo run lint --filter=@intrface/web",
    "lint:aoc": "turbo run lint --filter=@intrface/aoc-web",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean && rm -rf .turbo node_modules"
  },
  "devDependencies": {
    "turbo": "^2.9.6"
  }
}
